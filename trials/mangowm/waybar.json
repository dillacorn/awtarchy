{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "modules-left": [
    "custom/launcher",
    "custom/mango-tags"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "clock"
  ],
  "custom/launcher": {
    "format": "Apps",
    "on-click": "fuzzel",
    "tooltip": false
  },
  "tray": {
    "spacing": 6
  },
  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted"
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Offline"
  },
  "cpu": {
    "format": "CPU {usage}%"
  },
  "memory": {
    "format": "RAM {percentage}%"
  },
  "clock": {
    "format": "{:%a %b %d  %H:%M}"
  },
  "custom/mango-tags": {
    "exec": "bash $HOME/.config/mango/awtarchy-trial/status-tags.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },
  "wlr/taskbar": {
    "format": "{name}",
    "icon-size": 16,
    "on-click": "activate"
  }
}
