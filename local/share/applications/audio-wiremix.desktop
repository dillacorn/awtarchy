# github.com/dillacorn/awtarchy/tree/main/local/share/applications
# ~/.local/share/applications/audio-wiremix.desktop

[Desktop Entry]
Name=Audio Mixer (Wiremix)
Comment=Launch Wiremix in Foot
Type=Application
Exec=foot --app-id Wiremix --title Wiremix wiremix
Icon=audio-volume-high
Terminal=false
Categories=Audio;Utility;System;
Keywords=audio;volume;mixer;pulsemixer;pipewire;alsa;